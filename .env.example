# Copy to .env.local and fill in. Everything works without keys (mock mode).

# Qloo hackathon key (works only against the hackathon base URL). Empty = mock mode.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# auto | mock | live   (auto = live when QLOO_API_KEY is set)
QLOO_MODE=auto

# Anthropic key for the Claude agent + bilingual labels. Empty = scripted planner + templates.
ANTHROPIC_API_KEY=
# auto | mock | live
LLM_MODE=auto
# auto | llm | scripted
AGENT_MODE=auto
LLM_MODEL=claude-opus-5-5

# ARASAAC pictograms for core/safety tiles: on | off
PICTOGRAMS=on
