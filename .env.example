# Copy to .env.local and fill in. Everything works without keys (mock mode).

# Qloo hackathon key (works only against the hackathon base URL). Empty = mock mode.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# auto | mock | live   (auto = live when QLOO_API_KEY is set)
QLOO_MODE=auto

# LLM for the agent + bilingual labels: Claude or Gemini (either works). Neither = scripted planner + templates.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# auto | anthropic | gemini   (auto prefers Claude when both keys are set)
LLM_PROVIDER=auto
GEMINI_MODEL=gemini-3.5-flash
# auto | mock | live
LLM_MODE=auto
# auto | llm | scripted
AGENT_MODE=auto
LLM_MODEL=claude-opus-5-5

# ARASAAC pictograms for core/safety tiles: on | off
PICTOGRAMS=on

# Qloo trending window (the hackathon dataset ends around Sep 2025). Defaults: 2025-06-01 .. 2025-09-30
QLOO_TREND_START=
QLOO_TREND_END=
