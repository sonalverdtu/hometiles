// Looks up one ARASAAC pictogram per everyday word and writes src/lib/board/everyday-pictos.ts.
// Only the numeric ids are stored; the images still load from static.arasaac.org at runtime.
// Run: npx tsx scripts/everyday-pictos.mts

import { writeFileSync } from "node:fs";
import { EVERYDAY } from "../src/lib/board/everyday";

const out: Record<string, number> = {};
const queue = [...EVERYDAY];
async function worker() {
  for (let w = queue.shift(); w; w = queue.shift()) {
    try {
      const res = await fetch(`https://api.arasaac.org/v1/pictograms/en/search/${encodeURIComponent(w.arasaac)}`);
      const json = res.ok ? ((await res.json()) as { _id: number; keywords?: { keyword: string }[] }[]) : [];
      const first = json[0];
      if (first) {
        out[w.key] = first._id;
        console.log(`${w.key.padEnd(10)} ${first._id}  ${first.keywords?.[0]?.keyword ?? ""}`);
      } else console.log(`${w.key.padEnd(10)} (none)`);
    } catch (e) {
      console.log(`${w.key.padEnd(10)} error ${(e as Error).message}`);
    }
  }
}
await Promise.all(Array.from({ length: 6 }, worker));

const sorted = Object.fromEntries(EVERYDAY.filter((w) => out[w.key]).map((w) => [w.key, out[w.key]]));
writeFileSync(
  new URL("../src/lib/board/everyday-pictos.ts", import.meta.url),
  `// Generated by scripts/everyday-pictos.mts: ARASAAC pictogram id per everyday word (CC BY-NC-SA 4.0, Government of Aragón).\n\nexport const EVERYDAY_PICTOS: Record<string, number> = ${JSON.stringify(sorted, null, 2)};\n`,
);
console.log(`\n${Object.keys(sorted).length}/${EVERYDAY.length} words have a pictogram`);
